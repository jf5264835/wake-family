# Planning Center. Leave blank to keep registrations local and mark them as waiting for PCO.
PCO_APP_ID=
PCO_SECRET=

# Optional Google Places address autocomplete.
GOOGLE_MAPS_API_KEY=

# Bootstrap administrators for the current hosted/trusted-header auth path.
# Comma-separated email/identity values.
ADMIN_EMAILS=admin@wakechurch.example

# Self-hosted authentication bridge. Set these only when the application is
# behind a trusted authenticating reverse proxy and the origin port is private.
SELF_HOST_AUTH_EMAIL_HEADER=x-wake-auth-email
SELF_HOST_AUTH_NAME_HEADER=x-wake-auth-name

# Self-hosted process settings.
PORT=3000
SELFHOST_DATA_DIR=/data
